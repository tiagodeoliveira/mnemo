{
  "name": "mnemo",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "author": "Tiago Oliveira",
  "repository": {
    "type": "git",
    "url": "https://github.com/tiagodeoliveira/mnemo.git"
  },
  "keywords": [
    "ai",
    "memory",
    "bedrock",
    "agentcore",
    "claude",
    "cli"
  ],
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "infra",
    "cli"
  ],
  "scripts": {
    "lint": "eslint 'cli/**/*.ts' 'infra/**/*.ts' --max-warnings 0",
    "lint:fix": "eslint 'cli/**/*.ts' 'infra/**/*.ts' --fix --max-warnings 0",
    "test": "npm test --workspaces",
    "build": "npm run build --workspaces",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.2.0",
    "husky": "^9.1.7",
    "typescript-eslint": "^8.58.2"
  }
}
