# Required: your identity in the memory system
ACTOR_ID=
# Optional: email for alarm notifications and daily digest (requires SNS confirmation for alarms, SES-verified for digest)
NOTIFICATION_EMAIL=
# Optional: EventBridge cron for daily digest (default: cron(0 23 * * ? *))
# Examples: cron(0 19 * * ? *) for 7pm daily, cron(0 19 ? * MON-FRI *) for weekdays only
DIGEST_SCHEDULE=
# Optional: IANA timezone for digest schedule (default: UTC)
DIGEST_TIMEZONE=
# Optional: 'dev' or 'production' (default: production)
# production (default): payload bucket retained on `cdk destroy`, autoDelete disabled.
# dev: payload bucket destroyed with the stack for quick tear-down.
ENVIRONMENT=
