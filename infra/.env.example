# Required: seed actor for the actors table on first deploy. Also used as the
# hardcoded actor for ingest and recall until API-key-based resolution ships.
ACTOR_ID=
# Optional: email for alarm notifications and the seed actor's daily digest.
# Requires SNS confirmation for alarms, and SES-verified identity for digest.
NOTIFICATION_EMAIL=
# Optional: EventBridge cron for the digest dispatcher (default: cron(0 23 * * ? *))
# Examples: cron(0 19 * * ? *) for 7pm daily, cron(0 19 ? * MON-FRI *) for weekdays only
DIGEST_SCHEDULE=
# Optional: IANA timezone for the dispatcher schedule and for the seed actor's digest date (default: UTC)
DIGEST_TIMEZONE=
# Optional: 'dev' or 'production' (default: production)
# production (default): payload bucket retained on `cdk destroy`, autoDelete disabled.
# dev: payload bucket destroyed with the stack for quick tear-down.
ENVIRONMENT=
