# Local dev config. Copy to .env and adjust.
DATABASE_URL=postgres://mnemo:mnemo@localhost:5432/mnemo?sslmode=disable
MNEMO_PORT=8080
MNEMO_WORKER_COUNT=4

# Auth disabled in dev → every request maps to dev-actor.
MNEMO_AUTH_DISABLED=1
AUTH0_DOMAIN=
AUTH0_API_AUDIENCE=

# LLM stubbed in dev → extract jobs no-op.
MNEMO_LLM_DISABLED=1
ANTHROPIC_API_KEY=
MNEMO_LLM_MODEL=claude-sonnet-4-6
MNEMO_LLM_MAX_CONCURRENT=4

# Embeddings disabled in dev → /search returns 503.
MNEMO_EMBED_DISABLED=1
OPENAI_API_KEY=
MNEMO_EMBED_MODEL=text-embedding-3-small

# Optional SMTP for digest emails (unset = skip send).
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
